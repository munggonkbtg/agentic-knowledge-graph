            </mxGeometry>
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="D21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9673a6;dashed=1;exitX=1;exitY=0.25;entryX=0.25;entryY=1;" target="ent" value="MENTIONS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="B07" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9673a6;dashed=1;" target="ent" value="MENTIONS (หลังรวม&lt;br&gt;ชื่อไทย-อังกฤษ)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="al1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="ent" value="ALIAS_OF (ชั้น 3)">
          <mxGeometry relative="1" x="0.234" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L3" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="ส่วนที่ 2: ใช้กราฟเมื่อมีเอกสารเวอร์ชันใหม่ (impact analysis)" vertex="1">
          <mxGeometry height="275" width="1590" x="60" y="845" as="geometry" />
        </mxCell>
        <mxCell id="u1" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;8. อัปโหลดและระบุเอกสาร&lt;/b&gt;&lt;br&gt;เป็นเอกสารใด: รหัสจากทะเบียน → ความคล้ายของเนื้อหา → คนยืนยัน&lt;br&gt;แยก block ด้วยชั้น 0&lt;br&gt;Version ใหม่ &lt;b&gt;SUPERSEDES&lt;/b&gt; เวอร์ชันก่อน (ตั้ง valid_to); อัปเดตชื่อเอกสาร; &lt;b&gt;block ที่ไม่เปลี่ยนใช้ node เดิม&lt;/b&gt;" vertex="1">
          <mxGeometry height="175" width="180" x="15" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u2" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;9. จับคู่ block และ diff&lt;/b&gt;&lt;br&gt;1: hash ตรงกัน = ไม่เปลี่ยน&lt;br&gt;2: คล้ายใน section เดียวกัน (ตาม heading ที่เปลี่ยนชื่อได้) = &lt;b&gt;แก้&lt;/b&gt;&lt;br&gt;2b: คล้ายมากแต่อยู่ section อื่น = &lt;b&gt;แก้&lt;/b&gt; (ย้าย)&lt;br&gt;3: block ที่ถูกลบไปพบในไฟล์อื่นที่อัปโหลดพร้อมกัน = &lt;b&gt;ย้าย&lt;/b&gt; แยกได้สูงสุด 3 block&lt;br&gt;เชิงอรรถ: ข้อความตรงทุกตัวเท่านั้น&lt;br&gt;ที่เหลือ = &lt;b&gt;ลบ&lt;/b&gt; / &lt;b&gt;เพิ่ม&lt;/b&gt;&lt;br&gt;&lt;b&gt;เก็บไว้:&lt;/b&gt; สถานะ diff + block เดิมบน CONTAINS; block ที่ลบบน Version" vertex="1">
          <mxGeometry height="175" width="180" x="212" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u3" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;10. อัปเดตเบื้องต้น&lt;/b&gt;&lt;br&gt;รันชั้น 1–2 และ embedding กับเวอร์ชันปัจจุบัน (รันซ้ำไม่เปลี่ยนอะไร)&lt;br&gt;เพื่อให้ block ใหม่มี REFERENCES, MENTIONS และ vector ก่อนค้น" vertex="1">
          <mxGeometry height="175" width="180" x="409" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u4" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;11. หาผู้สมัคร&lt;/b&gt;&lt;br&gt;สัญญาณจากกราฟ (เฉพาะเส้นที่ยังมีผล): อ้าง section ที่เปลี่ยน; มีค่าเดิมของ attribute ที่ถูกเปลี่ยน; มี entity ร่วม; อ้างทั้งเอกสาร&lt;br&gt;+ hybrid search (trigram + e5)&lt;br&gt;&lt;b&gt;ไม่นับ entity ที่เป็น hub&lt;/b&gt;&lt;br&gt;&lt;i&gt;DEPENDS: ยังไม่ได้สร้าง&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="180" x="606" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u5" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;12. จัดอันดับ&lt;/b&gt;&lt;br&gt;&lt;b&gt;Graph-first&lt;/b&gt;: block ที่กราฟเข้าถึง เรียงตามสัญญาณที่แรงที่สุด แล้วต่อด้วยลำดับ hybrid (เลือกแทน RRF จากผลวัด)&lt;br&gt;&lt;b&gt;ใช้งานจริง:&lt;/b&gt; ตัดด้วยเกณฑ์คะแนน&lt;br&gt;&lt;b&gt;ตอนทดลอง:&lt;/b&gt; top N เท่ากับ baseline" vertex="1">
          <mxGeometry height="175" width="180" x="803" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u6" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;13. LLM ตรวจ&lt;/b&gt;&lt;br&gt;ข้อมูลเข้า: &lt;b&gt;ข้อความเดิม + ข้อความใหม่&lt;/b&gt; + block ผู้สมัคร&lt;br&gt;ผล: ต้องแก้ / ไม่กระทบ / ไม่แน่ใจ + เหตุผล + หลักฐานที่ยกจาก block ผู้สมัคร&lt;br&gt;Qwen3.5-4B ในเครื่อง 10 อันดับแรกต่อ change &lt;i&gt;(กำลังวัดผล)&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="180" x="1000" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u7" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;14. รายงานและคนตรวจ&lt;/b&gt;&lt;br&gt;ไฟล์, block ID, ช่วงบรรทัด, สัญญาณ → CSV (&lt;i&gt;kg impact&lt;/i&gt;)&lt;br&gt;&lt;i&gt;ยังไม่ได้สร้าง:&lt;/i&gt; กรองตามสิทธิ์การเข้าถึง; คนอนุมัติ / ปฏิเสธ แต่ละรายการ" vertex="1">
          <mxGeometry height="175" width="180" x="1197" y="45" as="geometry" />
        </mxCell>
        <mxCell id="u8" parent="L3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;i&gt;[ยังไม่ได้สร้าง: M6–M7]&lt;/i&gt;&lt;br&gt;&lt;b&gt;15. อัปเดตเต็ม&lt;/b&gt;&lt;br&gt;รันชั้น 3–4 กับ block ที่เปลี่ยน&lt;br&gt;relationship เดิมตั้ง valid_to (ไม่ลบ)&lt;br&gt;ลดความมั่นใจของ edge ที่นำไปสู่ผลที่ถูกปฏิเสธ" vertex="1">
          <mxGeometry height="175" width="180" x="1394" y="45" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="L3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontStyle=2;" value="จุดอ่อนที่ต้องรู้: dependency ที่ไม่ถูกสร้างเป็น edge จะหาไม่พบด้วยการเดินกราฟในขั้น 11 จึงต้องมี hybrid search ควบคู่เสมอ (ตอนนี้ยังไม่ได้สร้าง DEPENDS)" vertex="1">
          <mxGeometry height="35" width="1000" x="15" y="228" as="geometry" />
        </mxCell>
