        </mxCell>
        <mxCell id="e28" edge="1" parent="1" source="u8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=1;exitY=0.25;entryX=1;entryY=0.5;" target="s7" value="เขียนกลับ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L4" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="ส่วนที่ 3: การใช้งานอื่นของกราฟเดียวกัน" vertex="1">
          <mxGeometry height="145" width="1590" x="60" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="o1" parent="L4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ตอบคำถาม (graph-guided retrieval)&lt;/b&gt;&lt;br&gt;hybrid search หา block เริ่มต้น → ขยายผ่าน MENTIONS / REFERENCES → ส่ง LLM พร้อมอ้างอิงระดับ block" vertex="1">
          <mxGeometry height="90" width="490" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="o2" parent="L4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ดูความสัมพันธ์ในคลัง&lt;/b&gt;&lt;br&gt;เอกสารใดอ้างถึงเอกสารนี้ / entity นี้ปรากฏที่ไหนบ้าง / เวอร์ชันใดแทนที่เวอร์ชันใด (query ด้วย Cypher)" vertex="1">
          <mxGeometry height="90" width="490" x="540" y="42" as="geometry" />
        </mxCell>
        <mxCell id="o3" parent="L4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ตรวจคุณภาพคลัง&lt;/b&gt;&lt;br&gt;การอ้างอิงที่ชี้ไปยังเอกสารที่ไม่มีในคลัง, block ที่ระบุค่าของ entity เดียวกันไม่ตรงกัน" vertex="1">
          <mxGeometry height="90" width="490" x="1060" y="42" as="geometry" />
        </mxCell>
        <mxCell id="L5" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="ส่วนที่ 4: วัดผล (ทำคู่กับการสร้าง)" vertex="1">
          <mxGeometry height="160" width="1590" x="60" y="1305" as="geometry" />
        </mxCell>
        <mxCell id="ev1" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Gold labels ของ edge&lt;/b&gt;&lt;br&gt;ตาราง blind ให้คนกรอก (&lt;i&gt;_human&lt;/i&gt;); คำตอบของ AI แยกไว้ (&lt;i&gt;_ai&lt;/i&gt;) และไม่นับว่า &quot;เสร็จ&quot;&lt;br&gt;&lt;i&gt;ยังไม่มีคนติดป้าย&lt;/i&gt;&lt;br&gt;DEPENDS พบน้อย อาจต้องติดเพิ่ม" vertex="1">
          <mxGeometry height="105" width="365" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ev2" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;ชุดทดสอบการเปลี่ยนแปลง&lt;/b&gt;&lt;br&gt;การแก้จริง 40 + สังเคราะห์ 15 รายการ; รวมผู้สมัครจาก 5 วิธี + block ที่เพิ่มเอง; needs_review / needs_revision&lt;br&gt;block ประวัติ (กฎหมายแก้ไข, หมายเหตุเหตุผล) รายงานแยก" vertex="1">
          <mxGeometry height="105" width="365" x="410" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ev3" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;วัดรายชั้น&lt;/b&gt;&lt;br&gt;precision / recall ของ REFERENCES, MENTIONS (ตาราง blind พร้อมแล้ว), DEPENDS (แยกกัน)&lt;br&gt;อัตรารวม entity ผิด, ความคงที่ระหว่างรอบ (Jaccard)" vertex="1">
          <mxGeometry height="105" width="365" x="800" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ev4" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;การทดลองหลัก&lt;/b&gt;&lt;br&gt;Baseline (hybrid) เทียบ A ที่ N เท่ากัน: ทำแล้วกับป้ายของ AI (recall@5 0.28 → 0.66 แบบ graph-first)&lt;br&gt;B / C หลังมีชั้น 3–4; แยก 3 ชนิด passage + token ต่อไฟล์" vertex="1">
          <mxGeometry height="105" width="365" x="1190" y="42" as="geometry" />
        </mxCell>
        <mxCell id="e29" edge="1" parent="1" source="ev1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="ev3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e30" edge="1" parent="1" source="ev2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="ev4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e31" edge="1" parent="1" source="ev3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" target="ev4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e32" edge="1" parent="1" source="u7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" target="ev2" value="ผลอนุมัติ/ปฏิเสธ กลายเป็น label">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L6" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;" value="ส่วนที่ 5: สิ่งที่ต้องทดสอบก่อนสร้าง และข้อกำหนดเมื่อใช้งานจริง" vertex="1">
          <mxGeometry height="160" width="1590" x="60" y="1485" as="geometry" />
        </mxCell>
        <mxCell id="sp1" parent="L6" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;ทดสอบ 1: ความคงที่ของ block ID&lt;/b&gt;&lt;br&gt;เอกสาร 5 ฉบับที่มีสองเวอร์ชันจริง → parse และจับคู่ → นับว่าจับคู่ถูกกี่ %&lt;br&gt;ถ้าต่ำ ต้องแก้ชั้น 0 ก่อน เพราะทุกชั้นพึ่งมัน" vertex="1">
          <mxGeometry height="105" width="365" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="sp2" parent="L6" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;ทดสอบ 2: ภาษาไทย&lt;/b&gt;&lt;br&gt;NER ไทย: ไม่ต้องใช้ (ใช้กฎของทะเบียนแทน)&lt;br&gt;ตัวตัดคำไทยของ full-text ใน Neo4j: มีแล้ว ยังไม่ได้ใช้&lt;br&gt;วัดแยกไฟล์ OCR กับไฟล์ดิจิทัล" vertex="1">
          <mxGeometry height="105" width="365" x="410" y="42" as="geometry" />
        </mxCell>
        <mxCell id="sp3" parent="L6" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;ทดสอบ 3: การกระจายของ entity&lt;/b&gt;&lt;br&gt;นับว่า entity ที่พบบ่อยที่สุดอยู่ในกี่ block&lt;br&gt;ใช้ตั้งเกณฑ์ว่าอะไรคือ hub: &lt;i&gt;ทำแล้ว ใช้ 0.2&lt;/i&gt;" vertex="1">
          <mxGeometry height="105" width="365" x="800" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ops" parent="L6" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;ข้อกำหนดเมื่อใช้งานจริง&lt;/b&gt;&lt;br&gt;• สิทธิ์การเข้าถึงเก็บที่ Document และกรองทุก query (ยังไม่ได้กรอง)&lt;br&gt;• นโยบายสกัดใหม่เมื่อเปลี่ยน prompt หรือโมเดล (rule_version, prompt_version)&lt;br&gt;• สำรองข้อมูลตามรอบ (Community ไม่มี backup ออนไลน์)" vertex="1">
          <mxGeometry height="105" width="365" x="1190" y="42" as="geometry" />
        </mxCell>
        <mxCell id="lgt" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="80" x="60" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="ไม่ใช้ LLM" vertex="1">
          <mxGeometry height="30" width="190" x="150" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="LLM บางส่วน / เฉพาะ fallback" vertex="1">
          <mxGeometry height="30" width="190" x="350" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" value="LLM เป็นหลัก (เฉพาะคู่ผู้สมัคร)" vertex="1">
          <mxGeometry height="30" width="190" x="550" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" value="จัดเก็บ / คนตรวจ" vertex="1">
          <mxGeometry height="30" width="190" x="750" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="entity / alias" vertex="1">
          <mxGeometry height="30" width="190" x="950" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="ทดสอบก่อนสร้าง" vertex="1">
          <mxGeometry height="30" width="190" x="1150" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg6" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="เส้นประสีเทา = อ่าน/เขียนกราฟ ทะเบียน หรือ label" vertex="1">
          <mxGeometry height="30" width="300" x="1360" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="KG" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" value="องค์ประกอบของ Knowledge Graph (เก็บใน Neo4j)" vertex="1">
          <mxGeometry height="1670" width="640" x="1690" y="85" as="geometry" />
        </mxCell>
        <mxCell id="KGn" parent="KG" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;overflow=fill;" value="&lt;b&gt;Node (6 ชนิด)&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th align=&quot;left&quot;&gt;ชนิด&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;คืออะไร&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Document&lt;/b&gt;&lt;/td&gt;&lt;td&gt;เอกสารเชิงตรรกะ ไม่ผูกกับเวอร์ชัน เก็บรหัสเอกสารและสิทธิ์การเข้าถึง&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Version&lt;/b&gt;&lt;/td&gt;&lt;td&gt;เอกสารหนึ่งเวอร์ชัน (ไฟล์ที่อัปโหลดหนึ่งครั้ง)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Section&lt;/b&gt;&lt;/td&gt;&lt;td&gt;หัวข้อตาม heading ของ Markdown; แต่ละเวอร์ชันมี root Section และหัวข้อซ้อนอยู่ใต้มัน&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Block&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ย่อหน้า ตาราง รายการ หรือข้อของรายการ; role body / footnote; Block ID, content hash, embedding e5 (vector index) ช่วงบรรทัดเก็บแยกตามเวอร์ชันบน CONTAINS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Alias&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ชื่อที่จับได้ในข้อความ (ไทย อังกฤษ ชื่อย่อ); หนึ่ง Alias ชี้ Entity เดียว&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Entity&lt;/b&gt;&lt;/td&gt;&lt;td&gt;สิ่งที่ชื่อหมายถึง: Concept, Role, Artifact, Body, Place (กฎหมายเป็น Document; ค่าตัวเลขอยู่บน MENTIONS); มีธง hub&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="275" width="600" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="KGr" parent="KG" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;overflow=fill;" value="&lt;b&gt;Relationship (8 ชนิด)&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th align=&quot;left&quot;&gt;ชนิด&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;ความหมาย&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;สร้างด้วย&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;HAS_VERSION&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Document → Version&lt;/td&gt;&lt;td&gt;ขั้นระบุเอกสาร&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;CONTAINS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Version → root Section → Section → Block (เก็บ block ID ช่วงบรรทัด และลำดับของแต่ละเวอร์ชัน; หลังอัปโหลดมีสถานะ diff และ block เดิม)&lt;/td&gt;&lt;td&gt;parser&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;NEXT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;block ถัดไปในเวอร์ชันเดียวกัน&lt;/td&gt;&lt;td&gt;parser&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;SUPERSEDES&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Version ใหม่ → Version เดิม&lt;/td&gt;&lt;td&gt;ขั้นอัปโหลด (metadata)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Block → Document เชิงตรรกะ (เก็บ section ที่อ้างเป็น property)&lt;/td&gt;&lt;td&gt;regex + ทะเบียนเอกสาร (LLM สำหรับกรณีกำกวม: ยังไม่ได้ใช้)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;MENTIONS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Block → Entity (ชื่อที่จับได้อยู่ใน evidence_span; ค่าตัวเลข + หน่วย)&lt;/td&gt;&lt;td&gt;กฎของทะเบียน entity; ทดสอบ LLM fallback แล้ว ไม่นำมาใช้&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;ALIAS_OF&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alias → Entity (ยกเลิกได้)&lt;/td&gt;&lt;td&gt;ตอนนี้จากทะเบียน; ต่อไป embedding + LLM จัดกลุ่ม + ตรวจด้วยกฎ (M6)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc;&quot;&gt;&lt;td&gt;&lt;b&gt;DEPENDS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Block → Block ที่มันใช้ข้อเท็จจริง โดยไม่ได้อ้างตรง ๆ&lt;/td&gt;&lt;td&gt;LLM เฉพาะคู่ผู้สมัคร ต้องยกข้อความหลักฐานได้ (M7 ยังไม่ได้สร้าง)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;สีแถวตรงกับสัญลักษณ์: เขียว = ไม่ใช้ LLM, ฟ้า = LLM บางส่วน, ส้ม = LLM เป็นหลัก&lt;/i&gt;" vertex="1">
          <mxGeometry height="500" width="600" x="20" y="325" as="geometry" />
        </mxCell>
        <mxCell id="KGph" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;ข้อมูลกำกับบนทุก relationship&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ที่มา (provenance):&lt;/b&gt; evidence_block, evidence_span, method, model, prompt_version, confidence&lt;br&gt;• &lt;b&gt;rule_version:&lt;/b&gt; รันด้วยกฎใหม่แล้วเส้นของกฎเก่าถูกปิด&lt;br&gt;• &lt;b&gt;ช่วงเวลาที่มีผล:&lt;/b&gt; valid_from, valid_to — เมื่อเอกสารถูกแก้ relationship เดิมถูกปิดอายุ ไม่ถูกลบ&lt;br&gt;• &lt;b&gt;ผลการตรวจของคน:&lt;/b&gt; review_status (อนุมัติ / ปฏิเสธ) ใช้ปรับ confidence &lt;i&gt;(ยังไม่ได้สร้าง)&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="600" x="20" y="840" as="geometry" />
        </mxCell>
        <mxCell id="KGbh" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;การระบุและจับคู่ block ข้ามเวอร์ชัน&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Block ID&lt;/b&gt; = รหัสเอกสาร + เส้นทาง heading + ลำดับใน section (บอกว่าอยู่ที่ไหน)&lt;br&gt;• &lt;b&gt;กุญแจของ node&lt;/b&gt; ตั้งตอนพบ block ครั้งแรก block ที่ diff บอกว่าไม่เปลี่ยนใช้ node เดิมแม้ตำแหน่งเลื่อน&lt;br&gt;• จับคู่: 1 hash, 2 ข้อความคล้ายใน section เดียวกัน, 2b section อื่น, 3 เอกสารอื่น; เชิงอรรถตรงทุกตัวเท่านั้น&lt;br&gt;• block ที่ไม่เปลี่ยนใช้ node และ relationship เดิมต่อได้ ไม่ต้องสกัดใหม่" vertex="1">
          <mxGeometry height="135" width="600" x="20" y="1034" as="geometry" />
        </mxCell>
        <mxCell id="KGih" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;ดัชนีสำหรับค้นหา&lt;/b&gt;&lt;br&gt;vector index &lt;i&gt;block_embedding&lt;/i&gt; บน Block (e5, cosine) ใช้ใน &lt;i&gt;kg impact&lt;/i&gt;; ยังไม่ได้สร้าง full-text index (ใช้ trigram ใน Python); range index บน valid_to (ช่วยเงื่อนไข &quot;valid_to IS NULL&quot; ไม่ได้)" vertex="1">
          <mxGeometry height="130" width="600" x="20" y="1173" as="geometry" />
        </mxCell>
        <mxCell id="KGgh" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;ทะเบียนที่ใช้ประกอบ&lt;/b&gt;&lt;br&gt;ทะเบียนเอกสาร (front matter, ชื่อไฟล์, ชื่อเรื่อง, registry/aliases.yaml) + ทะเบียน entity (บทนิยาม, หัวข้อ, เรื่องของระเบียบ, registry/entities_manual.yaml)&lt;br&gt;ใช้ระบุเอกสารและสร้าง REFERENCES, MENTIONS" vertex="1">
          <mxGeometry height="120" width="600" x="20" y="1317" as="geometry" />
        </mxCell>
        <mxCell id="KGoh" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;สิ่งที่อยู่นอกกราฟ&lt;/b&gt;&lt;br&gt;• cache ผล LLM (SQLite): (content hash, prompt_version, model) → ผลลัพธ์&lt;br&gt;• ตารางป้ายแยกตามแหล่ง (_human / _ai) สำรองไว้นอก repository; ชุดทดสอบการเปลี่ยนแปลง&lt;br&gt;• รายงาน impact (CSV); ต่อไปคือประวัติผลการตรวจของคนจากขั้น 14" vertex="1">
          <mxGeometry height="125" width="600" x="20" y="1451" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>