        <mxCell id="L4" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="ส่วนที่ 3: การใช้งานอื่นของกราฟเดียวกัน" vertex="1">
          <mxGeometry height="145" width="1590" x="60" y="1140" as="geometry" />
