        <mxCell id="o1" parent="L4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ตอบคำถาม (graph-guided retrieval)&lt;/b&gt;&lt;br&gt;hybrid search หา block เริ่มต้น → ขยายผ่าน MENTIONS / REFERENCES → ส่ง LLM พร้อมอ้างอิงระดับ block" vertex="1">
          <mxGeometry height="90" width="490" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="o2" parent="L4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ดูความสัมพันธ์ในคลัง&lt;/b&gt;&lt;br&gt;เอกสารใดอ้างถึงเอกสารนี้ / entity นี้ปรากฏที่ไหนบ้าง / เวอร์ชันใดแทนที่เวอร์ชันใด (query ด้วย Cypher)" vertex="1">
          <mxGeometry height="90" width="490" x="540" y="42" as="geometry" />
        </mxCell>
        <mxCell id="o3" parent="L4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ตรวจคุณภาพคลัง&lt;/b&gt;&lt;br&gt;การอ้างอิงที่ชี้ไปยังเอกสารที่ไม่มีในคลัง, block ที่ระบุค่าของ entity เดียวกันไม่ตรงกัน" vertex="1">
          <mxGeometry height="90" width="490" x="1060" y="42" as="geometry" />
        </mxCell>
        <mxCell id="L5" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="ส่วนที่ 4: วัดผล (ทำคู่กับการสร้าง)" vertex="1">
          <mxGeometry height="160" width="1590" x="60" y="1305" as="geometry" />
        </mxCell>
        <mxCell id="ev1" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Gold labels ของ edge&lt;/b&gt;&lt;br&gt;10 ไฟล์ ~150 block ติดโดยคน (ไม่ใช่จากผลของกราฟ)&lt;br&gt;ติดซ้ำ 3 ไฟล์เพื่อวัด kappa&lt;br&gt;DEPENDS พบน้อย อาจต้องติดเพิ่ม" vertex="1">
          <mxGeometry height="105" width="365" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ev2" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;ชุดทดสอบการเปลี่ยนแปลง&lt;/b&gt;&lt;br&gt;30–50 กรณีแก้เอกสาร (ประมาณการ) พร้อมรายการ block ที่ต้องแก้ตามจริง&lt;br&gt;รวมผู้สมัครจากหลายวิธีค้น แล้วให้คนตัดสิน" vertex="1">
          <mxGeometry height="105" width="365" x="410" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ev3" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;วัดรายชั้น&lt;/b&gt;&lt;br&gt;precision / recall ของ REFERENCES, MENTIONS, DEPENDS (แยกกัน)&lt;br&gt;อัตรารวม entity ผิด, ความคงที่ระหว่างรอบ (Jaccard)" vertex="1">
          <mxGeometry height="105" width="365" x="800" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ev4" parent="L5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=3;spacing=5;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;การทดลองหลัก&lt;/b&gt;&lt;br&gt;Baseline (hybrid) เทียบ A / B / C ที่งบ N เท่ากัน&lt;br&gt;recall ของจุดที่ต้องแก้ แยก 3 ชนิด passage + token ต่อไฟล์" vertex="1">
          <mxGeometry height="105" width="365" x="1190" y="42" as="geometry" />
        </mxCell>
