          <mxGeometry height="30" width="190" x="550" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" value="จัดเก็บ / คนตรวจ" vertex="1">
          <mxGeometry height="30" width="190" x="750" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="entity / alias" vertex="1">
          <mxGeometry height="30" width="190" x="950" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="ทดสอบก่อนสร้าง" vertex="1">
          <mxGeometry height="30" width="190" x="1150" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="lg6" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="เส้นประสีเทา = อ่าน/เขียนกราฟ ทะเบียน หรือ label" vertex="1">
          <mxGeometry height="30" width="300" x="1360" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="KG" parent="1" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" value="องค์ประกอบของ Knowledge Graph (เก็บใน Neo4j)" vertex="1">
          <mxGeometry height="1560" width="640" x="1690" y="85" as="geometry" />
        </mxCell>
        <mxCell id="KGn" parent="KG" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;overflow=fill;" value="&lt;b&gt;Node (6 ชนิด)&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th align=&quot;left&quot;&gt;ชนิด&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;คืออะไร&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Document&lt;/b&gt;&lt;/td&gt;&lt;td&gt;เอกสารเชิงตรรกะ ไม่ผูกกับเวอร์ชัน เก็บรหัสเอกสารและสิทธิ์การเข้าถึง&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Version&lt;/b&gt;&lt;/td&gt;&lt;td&gt;เอกสารหนึ่งเวอร์ชัน (ไฟล์ที่อัปโหลดหนึ่งครั้ง)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Section&lt;/b&gt;&lt;/td&gt;&lt;td&gt;หัวข้อตาม heading ของ Markdown; แต่ละเวอร์ชันมี root Section และหัวข้อซ้อนอยู่ใต้มัน&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Block&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ย่อหน้า ตาราง รายการ หรือข้อของรายการ; role body / footnote; Block ID, content hash, embedding ช่วงบรรทัดเก็บแยกตามเวอร์ชันบน CONTAINS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Alias&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ชื่อที่พบจริงในข้อความ (ไทย อังกฤษ ชื่อย่อ)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Entity&lt;/b&gt;&lt;/td&gt;&lt;td&gt;สิ่งที่ชื่อเหล่านั้นหมายถึง เช่น หน่วยงาน ระบบ ระเบียบ ค่าที่กำหนด&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="275" width="600" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="KGr" parent="KG" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;overflow=fill;" value="&lt;b&gt;Relationship (8 ชนิด)&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th align=&quot;left&quot;&gt;ชนิด&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;ความหมาย&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;สร้างด้วย&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;HAS_VERSION&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Document → Version&lt;/td&gt;&lt;td&gt;ขั้นระบุเอกสาร&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;CONTAINS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Version → root Section → Section → Block (เก็บ block ID ช่วงบรรทัด และลำดับของแต่ละเวอร์ชัน)&lt;/td&gt;&lt;td&gt;parser&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;NEXT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;block ถัดไปในเวอร์ชันเดียวกัน&lt;/td&gt;&lt;td&gt;parser&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;SUPERSEDES&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Version ใหม่ → Version เดิม&lt;/td&gt;&lt;td&gt;ขั้นอัปโหลด (metadata)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;REFERENCES&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Block → Document เชิงตรรกะ (เก็บ section ที่อ้างเป็น property)&lt;/td&gt;&lt;td&gt;regex + ทะเบียนเอกสาร; LLM เฉพาะกรณีกำกวม&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;MENTIONS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Block → Alias&lt;/td&gt;&lt;td&gt;ทะเบียน entity, NER ไทย; LLM เมื่อได้ต่ำกว่าเกณฑ์&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;ALIAS_OF&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alias → Entity (ยกเลิกได้)&lt;/td&gt;&lt;td&gt;embedding + LLM จัดกลุ่ม + ตรวจด้วยกฎ&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc;&quot;&gt;&lt;td&gt;&lt;b&gt;DEPENDS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Block → Block ที่มันใช้ข้อเท็จจริง โดยไม่ได้อ้างตรง ๆ&lt;/td&gt;&lt;td&gt;LLM เฉพาะคู่ผู้สมัคร ต้องยกข้อความหลักฐานได้&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;สีแถวตรงกับสัญลักษณ์: เขียว = ไม่ใช้ LLM, ฟ้า = LLM บางส่วน, ส้ม = LLM เป็นหลัก&lt;/i&gt;" vertex="1">
          <mxGeometry height="500" width="600" x="20" y="325" as="geometry" />
        </mxCell>
        <mxCell id="KGph" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;ข้อมูลกำกับบนทุก relationship&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ที่มา (provenance):&lt;/b&gt; evidence_block, evidence_span, method, model, prompt_version, confidence&lt;br&gt;• &lt;b&gt;ช่วงเวลาที่มีผล:&lt;/b&gt; valid_from, valid_to — เมื่อเอกสารถูกแก้ relationship เดิมถูกปิดอายุ ไม่ถูกลบ&lt;br&gt;• &lt;b&gt;ผลการตรวจของคน:&lt;/b&gt; review_status (อนุมัติ / ปฏิเสธ) ใช้ปรับ confidence" vertex="1">
          <mxGeometry height="140" width="600" x="20" y="840" as="geometry" />
        </mxCell>
        <mxCell id="KGbh" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;การระบุและจับคู่ block ข้ามเวอร์ชัน&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Block ID&lt;/b&gt; = รหัสเอกสาร + เส้นทาง heading + ลำดับใน section (บอกว่าอยู่ที่ไหน)&lt;br&gt;• &lt;b&gt;กุญแจของ node&lt;/b&gt; ตั้งตอนพบ block ครั้งแรก block ที่ diff บอกว่าไม่เปลี่ยนใช้ node เดิมแม้ตำแหน่งเลื่อน&lt;br&gt;• จับคู่: 1 hash, 2 ข้อความคล้ายใน section เดียวกัน, 2b section อื่น, 3 เอกสารอื่น; เชิงอรรถตรงทุกตัวเท่านั้น&lt;br&gt;• block ที่ไม่เปลี่ยนใช้ node และ relationship เดิมต่อได้ ไม่ต้องสกัดใหม่" vertex="1">
          <mxGeometry height="135" width="600" x="20" y="994" as="geometry" />
        </mxCell>
        <mxCell id="KGih" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;ดัชนีสำหรับค้นหา&lt;/b&gt;&lt;br&gt;full-text index และ vector index บน Block ใช้ทำ hybrid search คู่กับการเดินกราฟ; index บน valid_to เพื่อกรอง relationship ที่ยังมีผล&lt;br&gt;&lt;i&gt;ต้องตรวจว่า analyzer ของ full-text รองรับภาษาไทย&lt;/i&gt;" vertex="1">
          <mxGeometry height="105" width="600" x="20" y="1133" as="geometry" />
        </mxCell>
        <mxCell id="KGgh" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;ทะเบียนที่ใช้ประกอบ&lt;/b&gt;&lt;br&gt;ทะเบียนเอกสาร + ทะเบียน entity จาก front matter, ชื่อไฟล์, รายชื่อหน่วยงาน/ระบบ&lt;br&gt;ใช้ตอนระบุเอกสาร สร้าง REFERENCES, MENTIONS และตอนรวม entity ที่ซ้ำ" vertex="1">
          <mxGeometry height="100" width="600" x="20" y="1252" as="geometry" />
        </mxCell>
        <mxCell id="KGoh" parent="KG" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;สิ่งที่อยู่นอกกราฟ&lt;/b&gt;&lt;br&gt;• cache ผล LLM: (content hash, prompt_version, model) → ผลลัพธ์&lt;br&gt;• gold labels และชุดทดสอบการเปลี่ยนแปลง&lt;br&gt;• ประวัติผลการตรวจของคนจากขั้น 14" vertex="1">
          <mxGeometry height="100" width="600" x="20" y="1366" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>