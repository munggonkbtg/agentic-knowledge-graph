          <mxGeometry height="30" width="210" x="1020" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c102" parent="1" style="text;html=1;align=left;fontSize=11;" value="&lt;b&gt;เส้นประ&lt;/b&gt; = สร้างภายหลังหรือทางเลือก" vertex="1">
          <mxGeometry height="30" width="530" x="1260" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;ขั้น 7: หาการพึ่งพากัน&lt;/b&gt;&lt;br&gt;หาส่วนที่ใช้ข้อเท็จจริงของส่วนอื่นโดยไม่ได้อ้างตรง ๆ&lt;br&gt;จับคู่เฉพาะส่วนที่น่าจะเกี่ยว (entity ร่วม / ความหมายใกล้)&lt;br&gt;LLM ตัดสิน ต้องยกข้อความหลักฐานจากทั้งสองส่วน&lt;br&gt;&lt;br&gt;&lt;b&gt;Node ที่ได้:&lt;/b&gt; &lt;i&gt;ไม่มี node ใหม่&lt;/i&gt;&lt;br&gt;&lt;b&gt;Edge ที่ได้:&lt;/b&gt; DEPENDS (chunk → chunk)" vertex="1">
          <mxGeometry height="190" width="230" x="1000" y="485" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;ขั้น 6: รวม entity ซ้ำ&lt;/b&gt;&lt;br&gt;หาชื่อที่น่าจะเป็นสิ่งเดียวกัน (ชื่อสั้น / ยาว, ไทย / อังกฤษ)&lt;br&gt;LLM ช่วยตัดสิน + กฎตรวจ&lt;br&gt;เก็บแบบย้อนกลับได้&lt;br&gt;&lt;br&gt;&lt;b&gt;Node ที่ได้:&lt;/b&gt; &lt;i&gt;ไม่มี node ใหม่&lt;/i&gt;&lt;br&gt;&lt;b&gt;Edge ที่ได้:&lt;/b&gt; ALIAS_OF (ชื่อที่ซ้ำ → entity หลัก)&lt;br&gt;&lt;i&gt;entity ที่ถูกรวมถูกทำเครื่องหมาย ไม่ถูกลบ&lt;/i&gt;" vertex="1">
          <mxGeometry height="190" width="230" x="1270" y="485" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;คนตัดสินเมื่อระบบไม่แน่ใจ&lt;/b&gt;&lt;br&gt;ระบบแสดงเอกสารที่ใกล้เคียงที่สุด 2–3 ฉบับ พร้อมคะแนน คนเลือกว่า:&lt;br&gt;• ไฟล์นี้เป็น&lt;b&gt;เวอร์ชันใหม่&lt;/b&gt;ของเอกสารฉบับไหน หรือ&lt;br&gt;• เป็น&lt;b&gt;เอกสารใหม่&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="250" x="720" y="365" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
